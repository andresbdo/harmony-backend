generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceCycle {
  INDEFINITE
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  lastName          String
  preferredCurrency String   @default("ARS")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ownedWorkspaces  Workspace[]
  workspaceMembers WorkspaceMember[]
  transactions     Transaction[]
  notifications    Notification[]
  settings         UserSettings?
  categories       Category[]
  apiTokens        ApiToken[]
}

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#1F6C9F")
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPersonal  Boolean  @default(false)
  inviteToken String?  @unique
  cutoffDay   Int      @default(1)
  cycle       WorkspaceCycle @default(MONTHLY)
  weekStartDay Int      @default(1)
  yearStartMonth Int     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       WorkspaceMember[]
  transactions  Transaction[]
  categories    Category[]
  bankAccounts  BankAccount[]
  budgets       Budget[]
  savings       Saving[]
  subscriptions Subscription[]
  settlements   WorkspaceSettlement[]
}

model WorkspaceSettlement {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  balances    Json
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, periodStart])
}

model WorkspaceMember {
  id                       String    @id @default(uuid())
  workspaceId              String
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId                   String?
  user                     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                    String
  nameAlias                String
  responsibilityPercentage Decimal   @default(50)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  paidTransactions Transaction[] @relation("PaidBy")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  type        String
  color       String
  icon        String
  scope       String
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  transactions Transaction[]
  Budget       Budget[]
}

model BankAccount {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  type           String
  subtype        String?   // "SAVINGS" | "CHECKING" | null
  currency       String
  currentBalance Decimal
  initialBalance Decimal
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cards        Card[]
  transactions Transaction[]
}

model Card {
  id                  String      @id @default(uuid())
  name                String
  type                String
  currency            String?
  creditLimit         Decimal?
  linkedBankAccountId String
  linkedBankAccount   BankAccount @relation(fields: [linkedBankAccountId], references: [id], onDelete: Cascade)
  statementCloseDay   Int
  dueDay              Int
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  transactions Transaction[]
}

model Budget {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amount      Decimal
  currency    String
  type        String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  month       Int
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, type, categoryId, month, year])
}

model Saving {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  targetAmount Decimal
  targetDate  DateTime?
  currency    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Decimal
  currency    String
  date        DateTime
  description String?
  type        String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  paidByMemberId String?
  paidByMember   WorkspaceMember? @relation("PaidBy", fields: [paidByMemberId], references: [id], onDelete: SetNull)

  paymentMethod String?
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  cardId        String?
  card          Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  savingGoalId String?
  savingGoal   Saving? @relation(fields: [savingGoalId], references: [id], onDelete: SetNull)

  isRecurrent    Boolean @default(false)
  recurrenceRule Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id              String    @id @default(uuid())
  name            String
  amount          Decimal
  currency        String
  frequency       String
  nextBillingDate DateTime
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions Transaction[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
}

model UserSettings {
  id         String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cotizacion1 String @default("oficial")
  cotizacion2 String?
}

model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal
  name         String?
  compra       Float?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, date, name])
}
